<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumes the built package from ../out, exactly as a user would.
       Publish self-contained for a test machine without .NET installed:
       dotnet publish -c Release -r linux-x64 \-\-self-contained -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../out</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JebteK.RdRand" Version="2.0.0" />
  </ItemGroup>

</Project>
