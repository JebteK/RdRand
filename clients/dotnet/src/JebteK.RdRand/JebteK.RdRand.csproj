<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>JebteK.RdRand</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>JebteK.RdRand</PackageId>
    <Version>2.0.0</Version>
    <Authors>JebteK, LLC</Authors>
    <Company>JebteK, LLC</Company>
    <Copyright>Copyright © 2014-2026 JebteK, LLC</Copyright>
    <Description>Hardware random numbers from the local CPU (RDRAND on x86_64, RNDR on ARM), falling back to the rdrand.com API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://rdrand.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>random rdrand rndr rng hardware true-random</PackageTags>
  </PropertyGroup>

  <!-- The shared hardware RNG library, one per runtime identifier. .NET picks
       the right one at run time; anywhere else the client uses the API. -->
  <ItemGroup>
    <None Include="../../native/linux-x64/librdrand_native.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="../../native/linux-arm64/librdrand_native.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="../../native/win32-x64/rdrand_native.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="../../native/darwin-x64/librdrand_native.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="../../native/darwin-arm64/librdrand_native.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
